# Copy this file to .env (or run `jira-kb init` to generate it for you at
# ~/.jira-kb-mcp/.env) and fill in your own values. Never commit a real .env.

# Your Jira Cloud site, e.g. https://yourcompany.atlassian.net
JIRA_URL=https://yourcompany.atlassian.net

# The email address of the Jira account the API token belongs to.
JIRA_EMAIL=you@example.com

# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Optional overrides:
# Where the local knowledge base (LanceDB files) is stored.
# JIRA_KB_DATA_DIR=~/.jira-kb-mcp

# Which embedding model fastembed should use. Default is multilingual.
# JIRA_KB_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
